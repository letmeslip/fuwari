---
import { url } from "../utils/url-utils";
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>★☆ Hyoroの裏部屋 ☆★</title>
    <style is:inline>
        #backroom-page,
        #backroom-page * { box-sizing: border-box; }
        body#backroom-page {
            margin: 0;
            color: #00ff66;
            color-scheme: light;
            background-color: #000033;
            background-image:
                radial-gradient(#222266 1px, transparent 1px),
                radial-gradient(#111155 1px, transparent 1px);
            background-position: 0 0, 8px 8px;
            background-size: 16px 16px;
            font-family: "MS PGothic", "ＭＳ Ｐゴシック", Osaka, sans-serif;
            font-size: 14px;
        }
        #backroom-page a { color: #00ffff; }
        #backroom-page a:visited { color: #ff66ff; }
        #backroom-page a:hover { color: #ffff00; background: #990099; }
        #backroom-page .page {
            width: 760px;
            max-width: calc(100% - 12px);
            margin: 10px auto 30px;
            border: 4px ridge #cccccc;
            background: #000044;
            box-shadow: 0 0 0 3px #000, 0 0 24px #0066ff;
        }
        #backroom-page .topline {
            padding: 4px;
            color: #ffff00;
            background: #000;
            border-bottom: 2px groove #aaa;
            white-space: nowrap;
            overflow: hidden;
        }
        #backroom-page header {
            padding: 20px 10px 12px;
            text-align: center;
            background: linear-gradient(#000066, #000022);
        }
        #backroom-page h1 {
            margin: 0 0 8px;
            color: #ff66ff;
            font-family: "Comic Sans MS", "MS PGothic", cursive;
            font-size: clamp(26px, 7vw, 46px);
            letter-spacing: 3px;
            text-shadow: 2px 2px #00ffff, 4px 4px #000;
        }
        #backroom-page .blink { animation: backroom-blink 0.8s steps(1) infinite; }
        @keyframes backroom-blink { 50% { opacity: 0; } }
        #backroom-page .counter {
            display: inline-block;
            padding: 2px 7px;
            color: #ff3333;
            background: #050505;
            border: 3px inset #aaa;
            font-family: "Courier New", monospace;
            font-size: 20px;
            letter-spacing: 3px;
        }
        #backroom-page table.layout { width: 100%; border-collapse: collapse; }
        #backroom-page table.layout > tbody > tr > td { vertical-align: top; }
        #backroom-page nav {
            width: 180px;
            min-height: 430px;
            padding: 10px;
            color: #fff;
            background: #330066;
            border-right: 3px ridge #ccc;
        }
        #backroom-page nav h2 {
            margin: 0 0 10px;
            color: #ffff00;
            font-size: 18px;
            text-align: center;
        }
        #backroom-page nav ul { margin: 0; padding: 0; list-style: none; }
        #backroom-page nav li { margin: 8px 0; }
        #backroom-page nav li::before { content: "◆ "; color: #ff66ff; }
        #backroom-page main { padding: 14px; }
        #backroom-page .box {
            margin: 0 0 16px;
            padding: 10px;
            border: 3px double #00ffff;
            background: #000022;
        }
        #backroom-page .box h2 {
            margin: -10px -10px 10px;
            padding: 3px 8px;
            color: #000;
            background: #00ffff;
            font-size: 16px;
        }
        #backroom-page .news { color: #fff; }
        #backroom-page .news dt { float: left; clear: left; width: 90px; color: #ffff00; }
        #backroom-page .news dd { margin-left: 95px; border-bottom: 1px dotted #6666aa; }
        #backroom-page .construction {
            color: #ffff00;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
        #backroom-page .construction span { display: inline-block; animation: backroom-swing 0.5s alternate infinite; }
        @keyframes backroom-swing { to { transform: translateY(-3px) rotate(3deg); } }
        #backroom-page footer {
            padding: 10px;
            color: #aaa;
            background: #000;
            border-top: 3px ridge #ccc;
            text-align: center;
            font-size: 12px;
        }
        #backroom-page .best-viewed { color: #888; font-size: 11px; }
        @media (max-width: 620px) {
            #backroom-page table.layout,
            #backroom-page table.layout tbody,
            #backroom-page table.layout tr,
            #backroom-page table.layout td { display: block; }
            #backroom-page nav { width: 100%; min-height: auto; border-right: 0; border-bottom: 3px ridge #ccc; }
            #backroom-page nav ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; }
        }
        @media (prefers-reduced-motion: reduce) {
            #backroom-page .blink,
            #backroom-page .construction span { animation: none; }
        }
    </style>
</head>
<body id="backroom-page">
<div class="page">
    <div class="topline">
        <marquee scrollamount="4">★☆★ ようこそ、インターネットのすみっこへ……キリ番を踏んだ人は掲示板にカキコしてね！ ★☆★</marquee>
    </div>
    <header>
        <div class="blink">★　WELCOME TO MY SECRET ROOM　★</div>
        <h1>Hyoroの裏部屋</h1>
        <div>あなたは <span id="counter" class="counter">000000</span> 人目の迷い人です</div>
    </header>

    <table class="layout" role="presentation">
        <tbody><tr>
            <td>
                <nav aria-label="裏ページメニュー">
                    <h2>† MENU †</h2>
                    <ul>
                        <li><a href="#about">この部屋について</a></li>
                        <li><a href="#diary">ひみつ日記</a></li>
                        <li><a href="#links">相互リンク</a></li>
                        <li><a href="#bbs">掲示板</a></li>
                        <li><a href={url('/')}>表サイトへ戻る</a></li>
                    </ul>
                    <hr />
                    <p class="construction"><span>🚧</span><br />工事中</p>
                    <p class="best-viewed">Internet Explorer 6.0<br />800×600以上推奨</p>
                </nav>
            </td>
            <td>
                <main>
                    <section class="box" id="about">
                        <h2>◆ この部屋について ◆</h2>
                        <p>表のサイトから秘密の入口を見つけた人だけが来られる、なんでもありの裏部屋です。</p>
                        <p><span class="blink">NEW!</span> 特に何もないけど、ゆっくりしていってね。</p>
                    </section>

                    <section class="box" id="diary">
                        <h2>◆ ひみつ日記 ◆</h2>
                        <dl class="news">
                            <dt>2026/07/18</dt><dd>裏ページを開設しました。</dd>
                            <dt>2004/08/32</dt><dd>夏休みが終わらないので日付を増やしました。</dd>
                            <dt>2000/01/01</dt><dd>インターネット、完全に理解した。</dd>
                        </dl>
                    </section>

                    <section class="box" id="links">
                        <h2>◆ 相互リンク ◆</h2>
                        <p>当サイトはリンクフリーです。報告は任意ですが、してくれると管理人が喜びます。</p>
                        <p>[ 200×40 バナー準備中 ]</p>
                    </section>

                    <section class="box" id="bbs">
                        <h2>◆ 掲示板 ◆</h2>
                        <p class="construction"><span>🚧</span> CGI設置予定！ <span>🚧</span></p>
                    </section>
                </main>
            </td>
        </tr></tbody>
    </table>

    <footer>
        since 2000.01.01 / last updated 2026.07.18<br />
        このページの無断転載を禁じます（気分）
    </footer>
</div>

<script is:inline>
    const key = 'backroom-counter';
    const visits = Number(localStorage.getItem(key) || '41') + 1;
    localStorage.setItem(key, String(visits));
    const counter = document.getElementById('counter');
    if (counter) counter.textContent = String(visits).padStart(6, '0');
</script>
</body>
</html>
